# Only the dataset pipeline (creating_the_dataset/) and the band table it reads are tracked.
# Everything else in STARFORGE (simulation tools, POLARIS, archives, ML experiments) stays local for now.
/*
!/.gitignore
!/wavelength_telescope_mapping.csv
!/creating_the_dataset/

# Large data products inside creating_the_dataset (regenerated by the pipeline, kept on disk only)
/creating_the_dataset/3.preparing_polaris_grids/grids_64/
/creating_the_dataset/3.preparing_polaris_grids/regression_cell_corner/
/creating_the_dataset/3.preparing_polaris_grids/legacy_reference/polaris_cores_v5/
/creating_the_dataset/3.preparing_polaris_grids/diagnostics/dust_to_gas_scans/*.npz
/creating_the_dataset/3.preparing_polaris_grids/dust_input/
/creating_the_dataset/1.finding_cores/dendrogram_cores_v5.2/**/*.hdf5

# Python and editor clutter
__pycache__/
*.pyc
.ipynb_checkpoints/
